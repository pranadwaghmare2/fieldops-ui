{
  "name": "@pranad/fieldops-ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "FieldOps React Native UI components with NativeWind dual style path",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranadwaghmare2/fieldops-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./preset": {
      "types": "./lib/typescript/src/preset.d.ts",
      "require": "./preset.cjs",
      "default": "./lib/module/preset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.*",
    "preset.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "bob build",
    "build": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "peerDependencies": {
    "nativewind": "^4.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.0.0",
    "nativewind": "^4.0.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-builder-bob": "^0.40.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
